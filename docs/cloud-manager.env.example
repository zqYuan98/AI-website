# Copy to ignored .env.local only when setting up an isolated cloud environment.
# Do not put real values in this example file or commit credentials.
# Neon URLs must retain sslmode=verify-full (both pooled runtime and direct administration).
RESOURCE_LIBRARY_MODE=cloud
DATABASE_URL=
# Optional CLI-only direct connection for the same private role, Neon branch and database.
# Keep DATABASE_URL as the runtime pooled connection. Do not deploy DATABASE_ADMIN_URL to Vercel.
DATABASE_ADMIN_URL=
LIBRARY_PUBLIC_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4300
LIBRARY_OWNER_ID=
